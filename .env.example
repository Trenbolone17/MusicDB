# Copy to .env and adjust. Every variable the project reads is listed here.

# --- App ---
NODE_ENV=development
# API port. Vite's dev proxy reads this too.
PORT=3000

# --- Postgres (docker-compose reads these as well) ---
POSTGRES_USER=songboard
POSTGRES_PASSWORD=songboard
POSTGRES_DB=songboard
# Host port for the Docker Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

DATABASE_URL=postgres://songboard:songboard@localhost:5433/songboard
# Tests truncate tables, so this must name a database ending in _test (created by docker/initdb).
TEST_DATABASE_URL=postgres://songboard:songboard@localhost:5433/songboard_test

# --- Auth ---
# Signs access tokens; 32+ characters. Fine for local use, but generate a real one before deploying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-before-deploying-0000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Send the refresh cookie over HTTPS only. Keep false for local http://localhost.
COOKIE_SECURE=false

# --- Rate limits ---
# Log-in and sign-up attempts allowed per IP address in each window.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# Ratings, edits, and deletions allowed per signed-in user in each window.
RATE_LIMIT_REVIEW_MAX=30
RATE_LIMIT_REVIEW_WINDOW_MINUTES=10

# --- Uploads (profile pictures) ---
# Only "disk" exists for now: files go under backend/UPLOADS_DIR and are served at PUBLIC_UPLOADS_URL.
STORAGE_DRIVER=disk
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_URL=/uploads

# --- Catalog seed (npm run seed:catalog) ---
# MusicBrainz and Wikimedia require a descriptive User-Agent with contact details.
SEED_USER_AGENT="Songboard/0.1 ( your-email@example.com )"
# Albums imported per artist, best-known first.
SEED_MAX_ALBUMS_PER_ARTIST=15
