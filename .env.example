# Copy to .env and adjust. Every variable the project reads is listed here.

# --- App ---
NODE_ENV=development
# API port. Vite's dev proxy reads this too.
PORT=3000

# --- Postgres (docker-compose reads these as well) ---
POSTGRES_USER=songboard
POSTGRES_PASSWORD=songboard
POSTGRES_DB=songboard
# Host port for the Docker Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

DATABASE_URL=postgres://songboard:songboard@localhost:5433/songboard
# Tests truncate tables, so this must name a database ending in _test (created by docker/initdb).
TEST_DATABASE_URL=postgres://songboard:songboard@localhost:5433/songboard_test
